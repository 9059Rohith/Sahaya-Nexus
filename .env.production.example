# Copy to .env.production and replace every value. Keep this file private.
# POSTGRES_PASSWORD must be URL-safe because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-32-or-more-url-safe-random-characters
SECRET_KEY=replace-with-32-or-more-random-characters
BFF_SHARED_SECRET=replace-with-a-different-32-or-more-random-characters
SAHAYA_DOMAIN=help.example.org
TLS_EMAIL=operator@example.org
# Optional: run with --profile ai, then pull the configured model into Ollama.
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=gemma3:4b
