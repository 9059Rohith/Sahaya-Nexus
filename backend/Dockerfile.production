FROM python:3.12-slim

RUN groupadd --system sahaya && useradd --system --gid sahaya --home-dir /app sahaya
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY --chown=sahaya:sahaya . .
RUN mkdir -p /app/data && chown sahaya:sahaya /app/data
USER sahaya

CMD ["sh", "-c", "alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000"]
